# ============================================
# account-ops 本地敏感信息配置（模板）
# ============================================
#
# ⚠️ 真实值在 .env.local（本地，git 看不到）
# ⚠️ .env.local.example 是模板，可推到远端
# ⚠️ .env.local 已在 .gitignore 排除，永远不会被 commit
#
# 用法：
#   1. 复制本文件 → .env.local
#      cp .env.local.example .env.local
#   2. 编辑 .env.local，填入真实值
#   3. 在 shell 里 source 它：
#        set -a && source .env.local && set +a
#      或在 Python 里：
#        from dotenv import load_dotenv
#        load_dotenv(".env.local")
#        import os; key = os.environ["NOTION_API_KEY"]
#
# 字段完整说明见 references/notion-schema.md §6
# ============================================

# === Notion 集成 API Key（必填，🔴 高度敏感）===
# 申请：https://www.notion.so/my-integrations
# 格式：ntn_xxx 或 secret_xxx
# ⚠️ 泄露 = 别人能操作你整个 Notion workspace
NOTION_API_KEY=your_notion_integration_key_here

# === Notion 工作系统结构 ID（必填，🟡 结构性引用）===
# 详细 ID 列表见你的 Notion workspace，每个 database 都有 2 个 ID

# 父页面（AI 工程师独立创作者）
NOTION_PARENT_PAGE_ID=your_parent_page_id_here

# 📥 项目调研池（database + data_source 各一个）
NOTION_DATABASE_RESEARCH_POOL_ID=your_research_pool_database_id_here
NOTION_DATA_SOURCE_RESEARCH_POOL_ID=your_research_pool_data_source_id_here

# 🎬 视频选题库
NOTION_DATABASE_TOPICS_ID=your_topics_database_id_here
NOTION_DATA_SOURCE_TOPICS_ID=your_topics_data_source_id_here

# 📝 视频脚本库
NOTION_DATABASE_SCRIPTS_ID=your_scripts_database_id_here
NOTION_DATA_SOURCE_SCRIPTS_ID=your_scripts_data_source_id_here
